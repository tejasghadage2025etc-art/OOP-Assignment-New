#include <iostream>
using namespace std;

// Base class to store basic information
class BasicInfo
{
private:
    string name;
    int age;

public:
    // Accept name and age
    void acceptBasicInfo()
    {
        cout << "Enter name: ";
        cin >> name;

        cout << "Enter age: ";
        cin >> age;
    }

    // Display name and age
    void dispBasicInfo()
    {
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
    }
};

// Base class to store department information
class deptInfo
{
private:
    string nameofdept;
    string natureofwork;

public:
    // Accept department and nature of work
    void acceptDeptInfo()
    {
        cout << "Enter department: ";
        cin >> nameofdept;

        cout << "Enter nature of work: ";
        cin >> natureofwork;
    }

    // Display department information
    void dispDeptInfo()
    {
        cout << "Department: " << nameofdept << endl;
        cout << "Nature of work: " << natureofwork << endl;
    }
};

// Employee class inherits from both base classes
class employee : public BasicInfo, public deptInfo
{
public:
    // Accept all employee information
    void acceptemployeeInfo()
    {
        acceptBasicInfo();
        acceptDeptInfo();
    }

    // Display all employee information
    void dispemployeeInfo()
    {
        dispBasicInfo();
        dispDeptInfo();
    }
};

int main()
{
    // Create two employee objects
    employee e1, e2;

    // Accept and display first employee's information
    e1.acceptemployeeInfo();
    e1.dispemployeeInfo();

    // Accept and display second employee's information
    e2.acceptemployeeInfo();
    e2.dispemployeeInfo();

    return 0; // End of program
}
