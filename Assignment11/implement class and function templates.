#include <iostream>
using namespace std;

// Function template
template <class T>
T add(T a, T b)
{
    return a + b;
}

template <class T>
T sub(T a, T b)
{
    return a - b;
}

// Class template
template <class T>
class Calculator
{
    T num1, num2;

public:
    Calculator(T n1, T n2)
    {
        num1 = n1;
        num2 = n2;
    }

    void dispres()
    {
        cout << "\nAddition = " << add(num1, num2);
        cout << "\nSubtraction = " << sub(num1, num2);
        cout << "\nMultiplication = " << mul(num1, num2);

        if (num2 != 0)
            cout << "\nDivision = " << divide(num1, num2);
        else
            cout << "\nDivision is not possible";

        cout << endl;
    }

    T mul(T a, T b)
    {
        return a * b;
    }

    T divide(T a, T b)
    {
        return a / b;
    }
};

int main()
{
    cout << "Function Template";
    cout << "\nAddition = " << add(5.2, 5.3);
    cout << "\nSubtraction = " << sub(5.8, 5.3);

    Calculator<int> i(6, 5);
    Calculator<double> d(6.5, 5.2);

    cout << "\n\nInteger Calculator";
    i.dispres();

    cout << "\nDouble Calculator";
    d.dispres();

    return 0;
}
